# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 커밋되지 않는다.
# 운영 환경에서는 GitHub Secrets 에 같은 이름으로 등록한다.

# 공공데이터포털 인증키 (일반 인증키, Decoding 값을 넣는다)
# 마이페이지 > 데이터활용 > 개발계정 > 활용신청 건 클릭 > 일반 인증키(Decoding)
# 9종 API가 같은 키를 공유한다.
DATA_GO_KR_SERVICE_KEY=

# Cloudflare R2 (S3 호환)
# 토큰은 버킷 하나로 범위를 제한한 "Object Read and Write" 계정 토큰을 쓴다.
# 대시보드 > R2 > API 토큰 > Create Account API Token
#   Permissions: Object Read & Write / Specify buckets: realdealmap-data
# 계정 ID는 대시보드 URL의 32자리 hex다. 비밀값은 아니지만 public 저장소이므로 여기 둔다.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=realdealmap-data


