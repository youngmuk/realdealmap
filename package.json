{
  "name": "realdealmap-data",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "regions:download": "node packages/shared/scripts/download-bjd.mjs",
    "regions:build": "node packages/shared/scripts/build-regions.mjs",
    "regions": "npm run regions:download && npm run regions:build",
    "probe": "node packages/ingest/scripts/probe-api.mjs",
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run coverage",
    "verify:r2": "node packages/ingest/scripts/verify-r2.mjs",
    "run:region": "node packages/ingest/scripts/run-region.mjs",
    "publish:region": "node packages/ingest/scripts/publish-region.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260907.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  }
}
