<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 인터넷: R2에서 데이터를 받는다 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      위치는 **두 단계로** 받는다. 좌표는 어느 쪽이든 기기 밖으로 나가지 않는다
      (앱 안에 이미 있는 지역 색인에서 시군구를 고를 뿐이다).

      1. 대략 위치 — 첫 진입에서 열어 볼 시군구 하나를 고르는 데 쓴다.
      2. 정밀 위치 — **지도의 "현재 위치" 버튼을 누른 사람에게만** 따로 묻는다.

      전에는 1번만 두고 정밀 위치를 매니페스트에서 아예 뺐다. 시군구를 고르는 데
      미터 단위 정확도가 필요 없다고 봤기 때문인데, 실기기에서 틀린 것으로
      드러났다 — 안드로이드의 대략 위치는 일부러 1~2km 격자로 뭉갠 값을 준다.
      군자동(광진구 경계에서 북쪽으로 700m)에서 눌렀더니 동대문구가 열렸다.
      구 한가운데면 맞지만 경계 근처에서는 옆 구로 넘어가고, "현재 위치"라면서
      줌 16으로 들어가는 버튼에서는 그 오차가 그대로 보인다.

      단계를 나누는 일은 MainActivity가 한다 — geolocator는 여기 선언된 것을
      전부 한꺼번에 요청해서, 그대로 두면 첫 실행에도 "정확한 위치" 창이 뜬다.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!--
      기기 백업에 담지 않는다.

      여기 저장하는 것은 전부 **다시 받을 수 있는 것**이다 — 공개된 실거래 자료와
      마지막으로 본 지역뿐이라, 복원해서 얻는 것이 없다. 반대로 기본값(true)으로
      두면 이 캐시가 사용자의 클라우드 백업과 `adb backup` 경로에 그대로 실린다.
      지금 담긴 것이 민감하지 않다는 이유로 열어 두면, 나중에 저장 항목이 늘 때
      아무도 이 결정을 다시 보지 않는다.
    -->
    <application
        android:label="실거래지도"
        android:name="${applicationName}"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- AdMob 앱 ID. admob.dart의 kInterstitialUnitId와 **짝이다.**
             앱 ID는 `~`, 광고 단위 ID는 `/`로 갈린다. 서로 바꿔 넣거나 한쪽만
             고치면 광고가 조용히 안 나온다 — 화면은 멀쩡하고 수익만 0이다.

             빌드 모드로 갈리지 않는다. 앱 ID는 식별자일 뿐 광고를 내려주지
             않으므로 디버그에서도 실제 값을 쓴다. 실제 광고를 내려받는 것은
             단위 ID 쪽이고, 그쪽만 kReleaseMode로 갈린다.

             반드시 <application>의 직계 자식이어야 한다. <activity> 안에 두면
             SDK가 앱 ID를 못 찾아 MobileAdsInitProvider가 앱을 죽인다.
             실기기에서 그렇게 죽여 보고 알았다. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-9171388280674877~3639315696" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
